rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        );
    }

    match /images/{fileName} {

      // Portfolio images must be publicly viewable.
      allow read: if true;

      // Only approved administrators may upload or replace images.
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only approved administrators may delete images.
      allow delete: if isAdmin();
    }

    // Deny anything outside the expected images directory.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}