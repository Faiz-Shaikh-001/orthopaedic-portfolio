rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    /*
     * Public website content
     *
     * Anyone may read the portfolio because it powers
     * the public website.
     *
     * Only explicitly registered administrators may
     * modify it.
     */
    match /website_content/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /*
     * Admin allow-list
     *
     * These documents are created manually through the
     * Firebase Console or a trusted backend process.
     *
     * The browser cannot create or modify administrator
     * permissions.
     */
    match /admins/{userId} {
      allow read, write: if false;
    }

    /*
     * Deny everything that has not been explicitly
     * granted above.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
